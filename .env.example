# Local development example; replace all example credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public SEO identity; independent of local login Origin and preview URLs.
NEXT_PUBLIC_CANONICAL_URL=https://mocktest-sigma.vercel.app
# Optional Search Console HTML-tag verification token (not the entire meta tag).
GOOGLE_SITE_VERIFICATION=
APP_ORIGIN=http://localhost:3000
# Optional: set only when you control this contact mailbox.
NEXT_PUBLIC_CONTACT_EMAIL=
DATABASE_URL=postgresql://testdisha_app:replace-runtime-password@127.0.0.1:5433/testdisha
# Owner/direct connection is for CLI migrations, seeding and backups only.
# Do not add this variable to the hosted application's runtime environment.
DATABASE_MIGRATION_URL=postgresql://testdisha_owner:replace-owner-password@127.0.0.1:5433/testdisha
DATABASE_POOL_SIZE=3
POSTGRES_PASSWORD=replace-owner-password
ADMIN_BOOTSTRAP_EMAIL=admin@testdisha.local
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-strong-password
